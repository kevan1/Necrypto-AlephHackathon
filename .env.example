# ==================================
# NEORYPTO - Environment Variables
# ==================================
# Copy this file to .env.local and fill in your values
# DO NOT commit .env.local to version control

# ----------------------------------
# OnchainKit (Coinbase)
# ----------------------------------
# Get API key from: https://portal.cdp.coinbase.com/products/onchainkit
NEXT_PUBLIC_ONCHAINKIT_API_KEY=
NEXT_PUBLIC_ONCHAINKIT_PROJECT_NAME=Neorypto

# ----------------------------------
# App Configuration
# ----------------------------------
# Your app's public URL (use http://localhost:3000 for local dev)
NEXT_PUBLIC_URL=http://localhost:3000

# App icon (hosted URL or path to /public)
NEXT_PUBLIC_ICON_URL=

# ----------------------------------
# Farcaster Frame Metadata
# ----------------------------------
# Frame account association credentials
# Generate with: npx create-onchain --manifest
FARCASTER_HEADER=
FARCASTER_PAYLOAD=
FARCASTER_SIGNATURE=

# Frame metadata for casting
NEXT_PUBLIC_APP_ICON=
NEXT_PUBLIC_APP_SUBTITLE=Secure your digital inheritance
NEXT_PUBLIC_APP_DESCRIPTION=Digital inheritance for the crypto era
NEXT_PUBLIC_APP_SPLASH_IMAGE=
NEXT_PUBLIC_SPLASH_BACKGROUND_COLOR=#000000
NEXT_PUBLIC_APP_PRIMARY_CATEGORY=utilities
NEXT_PUBLIC_APP_HERO_IMAGE=
NEXT_PUBLIC_APP_TAGLINE=Secure your assets, protect your legacy
NEXT_PUBLIC_APP_OG_TITLE=Neorypto - Digital Inheritance
NEXT_PUBLIC_APP_OG_DESCRIPTION=Lock your crypto assets in a secure vault, assign trusted guardians, and ensure your legacy lives on.
NEXT_PUBLIC_APP_OG_IMAGE=

# ----------------------------------
# Redis / Upstash (Optional)
# ----------------------------------
# Required for notifications and webhooks
# Get credentials from: https://upstash.com/
# Leave empty to disable notifications (app will still work)
REDIS_URL=
REDIS_TOKEN=
